@model IEnumerable<DigDog.Models.Venda>
@{
    ViewData["Title"] = "Vendas";
    var criptografarId = ViewBag.CriptografarId as Func<int, string>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.css" />

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5"><i class="cil-cart me-2"></i>Vendas</strong>
        <div class="d-flex gap-2">
            <a asp-controller="Produto" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="cil-arrow-left me-1"></i> Produtos
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="cil-plus me-1"></i> Nova Venda
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-body-secondary py-5">
                <i class="cil-cart" style="font-size: 2.5rem;"></i>
                <p class="mt-3 mb-1 fw-semibold">Nenhuma venda registrada</p>
                <small>Clique em "Nova Venda" para começar.</small>
            </div>
        }
        else
        {
            <div class="px-3 pt-3">
                <table id="tabelaVenda" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Data</th>
                            <th>Total</th>
                            <th class="d-none d-md-table-cell">Qtd.</th>
                            <th class="d-none d-md-table-cell">Preço Unit.</th>
                            <th class="d-none d-lg-table-cell">Observações</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venda in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@(venda.Produto?.Nome ?? "—")</td>
                                <td data-order="@venda.DataVenda.ToString("yyyy-MM-dd HH:mm")">
                                    @venda.DataVenda.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="fw-semibold">@venda.Total.ToString("C2")</td>
                                <td class="d-none d-md-table-cell">@venda.Quantidade</td>
                                <td class="d-none d-md-table-cell">@venda.PrecoUnitario.ToString("C2")</td>
                                <td class="d-none d-lg-table-cell">@(venda.Observacoes ?? "—")</td>
                                <td class="text-end">
                                    <a asp-action="Delete" asp-route-id="@criptografarId(venda.Id)"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Cancelar Venda" data-coreui-toggle="tooltip">
                                        <i class="cil-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive/2.5.0/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaVenda').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                responsive: true,
                order: [[1, 'desc']],
                columnDefs: [
                    { responsivePriority: 1, targets: 0 }, // Produto
                    { responsivePriority: 2, targets: 6 }, // Ações
                    { responsivePriority: 3, targets: 1 }, // Data
                    { responsivePriority: 4, targets: 2 }, // Total
                    { responsivePriority: 5, targets: 3 }, // Qtd
                    { responsivePriority: 6, targets: 4 }, // Preço Unit
                    { responsivePriority: 7, targets: 5 }, // Observações
                    { orderable: false, targets: 6 }
                ],
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50]
            });

            document.querySelectorAll('[data-coreui-toggle="tooltip"]').forEach(el => {
                new coreui.Tooltip(el);
            });
        });
    </script>
}