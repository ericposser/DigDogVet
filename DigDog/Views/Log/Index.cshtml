@model IEnumerable<DigDog.Models.Log>
@{
    ViewData["Title"] = "Log de Atividades";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.css" />

@* Modal de confirmação — delete individual *@
<div class="modal fade" id="modalConfirmarDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <i class="cil-warning text-danger me-2"></i>Confirmar exclusão
                </h5>
                <button type="button" class="btn-close" data-coreui-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Deseja remover este registro de log? Esta ação não pode ser desfeita.
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-coreui-dismiss="modal">
                    <i class="cil-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="btnConfirmarDelete">
                    <i class="cil-trash me-1"></i>Remover
                </button>
            </div>
        </div>
    </div>
</div>

@* Modal de confirmação — limpar tudo *@
<div class="modal fade" id="modalConfirmarLimpar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <i class="cil-warning text-danger me-2"></i>Limpar todos os registros
                </h5>
                <button type="button" class="btn-close" data-coreui-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Todos os registros de log serão removidos permanentemente. Esta ação não pode ser desfeita.
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-coreui-dismiss="modal">
                    <i class="cil-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="btnConfirmarLimpar">
                    <i class="cil-trash me-1"></i>Limpar tudo
                </button>
            </div>
        </div>
    </div>
</div>

@* Forms ocultos para submissão *@
<form id="formLimparTodos" asp-action="LimparTodos" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>
<form id="formDeleteIndividual" asp-action="Delete" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="inputIdLog" name="id" value="" />
</form>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5">
            <i class="cil-notes me-2"></i>Log de Atividades
        </strong>
        @if (Model.Any())
        {
            <button type="button" class="btn btn-outline-danger btn-sm" id="btnAbrirLimpar">
                <i class="cil-trash me-1"></i>Limpar tudo
            </button>
        }
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-body-secondary py-5">
                <i class="cil-notes" style="font-size:2.5rem; opacity:.4"></i>
                <p class="mt-3 mb-1 fw-semibold">Nenhuma atividade registrada</p>
                <small>As ações dos funcionários aparecerão aqui.</small>
            </div>
        }
        else
        {
            <div class="px-3 pt-3">
                <table id="tabelaLog" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Funcionário</th>
                            <th>Ação</th>
                            <th>Módulo</th>
                            <th>Descrição</th>
                            <th>Data e Hora</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            var corAcao = log.Acao switch
                            {
                                "Criou"   => "bg-success",
                                "Editou"  => "bg-warning text-dark",
                                "Excluiu" => "bg-danger",
                                _         => "bg-secondary"
                            };
                            <tr>
                                <td class="fw-semibold">
                                    <i class="cil-user me-1 text-body-secondary"></i>
                                    @log.NomeFuncionario
                                </td>
                                <td>
                                    <span class="badge @corAcao">@log.Acao</span>
                                </td>
                                <td class="text-body-secondary small">@log.Modulo</td>
                                <td>@log.Descricao</td>
                                <td class="text-body-secondary small">
                                    @log.DataHora.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm btn-deletar-log"
                                            data-id="@log.Id"
                                            title="Remover" data-coreui-toggle="tooltip">
                                        <i class="cil-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive/2.5.0/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaLog').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                responsive: true,
                order: [[4, 'desc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                columnDefs: [{ orderable: false, targets: 5 }]
            });

            document.querySelectorAll('[data-coreui-toggle="tooltip"]').forEach(el => {
                new coreui.Tooltip(el);
            });

            // ── Delete individual ─────────────────────────────────────────
            const modalDelete  = new coreui.Modal(document.getElementById('modalConfirmarDelete'));
            const inputId      = document.getElementById('inputIdLog');
            const formDelete   = document.getElementById('formDeleteIndividual');
            const btnConfirmar = document.getElementById('btnConfirmarDelete');

            document.querySelectorAll('.btn-deletar-log').forEach(btn => {
                btn.addEventListener('click', function () {
                    inputId.value = this.dataset.id;
                    modalDelete.show();
                });
            });

            btnConfirmar.addEventListener('click', function () {
                formDelete.submit();
            });

            // ── Limpar tudo ───────────────────────────────────────────────
            const modalLimpar    = new coreui.Modal(document.getElementById('modalConfirmarLimpar'));
            const btnAbrirLimpar = document.getElementById('btnAbrirLimpar');
            const btnConfLimpar  = document.getElementById('btnConfirmarLimpar');
            const formLimpar     = document.getElementById('formLimparTodos');

            if (btnAbrirLimpar) {
                btnAbrirLimpar.addEventListener('click', function () {
                    modalLimpar.show();
                });
            }

            btnConfLimpar.addEventListener('click', function () {
                formLimpar.submit();
            });
        });
    </script>
}