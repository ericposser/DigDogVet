@* _BotaoLembrete.cshtml
   Uso:
     @await Html.RenderPartialAsync("_BotaoLembrete", new DigDog.Models.LembreteViewModel
     {
         TelefoneTutor  = Model.Pet.Cliente.Telefone,
         NomeTutor      = Model.Pet.Cliente.Nome,
         NomePet        = Model.Pet.Nome,
         Servico        = "consulta",          // ou "banho e tosa"
         DataHora       = Model.DataHora
     })
*@
@model DigDog.Models.LembreteViewModel

@{
    // Formata data/hora no padrão brasileiro
    var dataFormatada = Model.DataHora.ToString("dd/MM/yyyy 'às' HH:mm");

    // Monta a mensagem de lembrete
    var mensagem = $"Olá, {Model.NomeTutor}! 😊 Só passando para confirmar seu agendamento de "
                 + $"{Model.Servico} para seu pet *{Model.NomePet}* "
                 + $"marcado para *{dataFormatada}*. "
                 + $"Qualquer dúvida, é só falar! Até lá! 🐾";

    // Limpa o telefone deixando apenas dígitos e monta a URL do WhatsApp
    var telefoneLimpo = System.Text.RegularExpressions.Regex.Replace(
        Model.TelefoneTutor ?? "", @"\D", "");

    // Garante o código do país (55 = Brasil) se não tiver
    if (!string.IsNullOrEmpty(telefoneLimpo) && !telefoneLimpo.StartsWith("55"))
        telefoneLimpo = "55" + telefoneLimpo;

    var mensagemCodificada = Uri.EscapeDataString(mensagem);
    var urlWhatsApp = $"https://wa.me/{telefoneLimpo}?text={mensagemCodificada}";

    var temTelefone = !string.IsNullOrWhiteSpace(telefoneLimpo);
}

@if (temTelefone)
{
    <a href="@urlWhatsApp"
       target="_blank"
       rel="noopener noreferrer"
       class="btn btn-lembrete-wpp d-inline-flex align-items-center gap-2"
       title="Enviar lembrete via WhatsApp para @Model.NomeTutor">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
        </svg>
        Lembrete
    </a>
}
else
{
    <button type="button"
            class="btn btn-lembrete-wpp disabled d-inline-flex align-items-center gap-2"
            title="Tutor sem telefone cadastrado"
            disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
        </svg>
        Lembrete
        <span class="badge bg-secondary ms-1" style="font-size: 0.6rem;">Sem tel.</span>
    </button>
}

@* CSS específico do botão — injetado uma única vez via section ou inline *@
<style>
    .btn-lembrete-wpp {
        background-color: #25d366;
        border-color: #25d366;
        color: #fff;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        transition: background-color 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease;
        box-shadow: 0 2px 6px rgba(37, 211, 102, 0.30);
        text-decoration: none;
    }

    .btn-lembrete-wpp:hover:not(:disabled) {
        background-color: #1ebe5d;
        border-color: #1ebe5d;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.45);
    }

    .btn-lembrete-wpp:active:not(:disabled) {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(37, 211, 102, 0.30);
    }

    .btn-lembrete-wpp.disabled,
    .btn-lembrete-wpp:disabled {
        background-color: #6c757d;
        border-color: #6c757d;
        color: #fff;
        opacity: 0.65;
        cursor: not-allowed;
        box-shadow: none;
    }
</style>
