@model DigDog.Models.Vacinacao
@{
    ViewData["Title"] = "Editar Vacinação";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5"><i class="cil-pencil me-2"></i>Editar Vacinação</strong>
    </div>

    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.IdCriptografado" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small" role="alert"></div>

            <div class="row g-3">

                <!-- Pet -->
                <div class="col-md-6">
                    <label asp-for="IdPet" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                    <select asp-for="IdPet" class="form-select" asp-items="ViewBag.IdPet">
                        <option value="">— Selecione o pet —</option>
                    </select>
                    <span asp-validation-for="IdPet" class="text-danger small"></span>
                </div>

                <!-- Vacina -->
                <div class="col-md-6">
                    <label asp-for="IdVacina" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                    <select asp-for="IdVacina" class="form-select" asp-items="ViewBag.IdVacina">
                        <option value="">— Selecione a vacina —</option>
                    </select>
                    <span asp-validation-for="IdVacina" class="text-danger small"></span>
                </div>

                <!-- Dose -->
                <div class="col-md-4">
                    <label asp-for="Dose" class="form-label fw-semibold"></label>
                    <select asp-for="Dose" class="form-select">
                        <option value="">— Selecione —</option>
                        <option value="1ª Dose">1ª Dose</option>
                        <option value="2ª Dose">2ª Dose</option>
                        <option value="3ª Dose">3ª Dose</option>
                        <option value="Reforço Anual">Reforço Anual</option>
                        <option value="Dose Única">Dose Única</option>
                        <option value="Outro">Outro</option>
                    </select>
                    <span asp-validation-for="Dose" class="text-danger small"></span>
                </div>

                <!-- Data de Aplicação -->
                <div class="col-md-4">
                    <label asp-for="DataAplicacao" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                    <input asp-for="DataAplicacao" class="form-control" type="date"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DataAplicacao" class="text-danger small"></span>
                </div>

                <!-- Próxima Dose -->
                <div class="col-md-4">
                    <label asp-for="DataProximaDose" class="form-label fw-semibold"></label>
                    <input asp-for="DataProximaDose" class="form-control" type="date" />
                    <span asp-validation-for="DataProximaDose" class="text-danger small"></span>
                </div>

                <!-- Observações -->
                <div class="col-12">
                    <label asp-for="Observacoes" class="form-label fw-semibold"></label>
                    <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Observacoes" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="cil-x me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="cil-save me-1"></i> Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}