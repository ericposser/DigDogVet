@model IEnumerable<DigDog.Models.Cliente>
@{
    ViewData["Title"] = "Tutores";
    var criptografarId = ViewBag.CriptografarId as Func<int, string>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.css" />

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5"><i class="cil-people me-2"></i>Tutores</strong>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="cil-user-follow me-1"></i> Novo Tutor
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-body-secondary py-5">
                <i class="cil-people" style="font-size: 2.5rem;"></i>
                <p class="mt-3 mb-1 fw-semibold">Nenhum tutor cadastrado</p>
                <small>Clique em "Novo Tutor" para começar.</small>
            </div>
        }
        else
        {
            <div class="px-3 pt-3">
                <table id="tabelaCliente" class="table table-striped table-hover align-middle w-100">
                    <thead>
                    <tr>
                        <th>Nome do Tutor</th>
                        <th class="d-none d-md-table-cell">CPF</th>
                        <th>Telefone</th>
                        <th class="d-none d-md-table-cell">E-mail</th>
                        <th class="d-none d-lg-table-cell">Endereço</th>
                        <th class="text-end">Ações</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var cliente in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@cliente.Nome</td>
                            <td class="d-none d-md-table-cell">@(cliente.Cpf ?? "—")</td>
                            <td class="telefone-cell">@cliente.Telefone</td>
                            <td class="d-none d-md-table-cell">@(cliente.Email ?? "—")</td>
                            <td class="d-none d-lg-table-cell">@(cliente.Endereco ?? "—")</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@criptografarId(cliente.Id)"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Editar" data-coreui-toggle="tooltip">
                                        <i class="cil-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@criptografarId(cliente.Id)"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Excluir" data-coreui-toggle="tooltip">
                                        <i class="cil-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive/2.5.0/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaCliente').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                responsive: true,
                order: [[0, 'asc']],
                columnDefs: [
                    { responsivePriority: 1, targets: 0 }, // Nome
                    { responsivePriority: 2, targets: 5 }, // Ações
                    { responsivePriority: 3, targets: 2 }, // Telefone
                    { responsivePriority: 4, targets: 1 }, // CPF
                    { responsivePriority: 5, targets: 3 }, // Email
                    { responsivePriority: 6, targets: 4 }, // Endereço
                    { orderable: false, targets: 5 }
                ],
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50]
            });

            document.querySelectorAll('[data-coreui-toggle="tooltip"]').forEach(el => {
                new coreui.Tooltip(el);
            });

            document.querySelectorAll('.telefone-cell').forEach(cel => {
                const v = cel.textContent.trim().replace(/\D/g, '');
                if (v.length === 11) cel.textContent = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
                else if (v.length === 10) cel.textContent = v.replace(/^(\d{2})(\d{4})(\d{4})$/, '($1) $2-$3');
            });
        });
    </script>
}
