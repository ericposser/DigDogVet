@model IEnumerable<DigDog.Models.Pet>
@{
    ViewData["Title"] = "Pets";
    var criptografarId = ViewBag.CriptografarId as Func<int, string>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.css" />

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5"><i class="cil-animal me-2"></i>Pets</strong>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="cil-plus me-1"></i> Novo Pet
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-body-secondary py-5">
                <i class="cil-animal" style="font-size: 2.5rem;"></i>
                <p class="mt-3 mb-1 fw-semibold">Nenhum pet cadastrado</p>
                <small>Clique em "Novo Pet" para começar.</small>
            </div>
        }
        else
        {
            <div class="px-3 pt-3">
                <table id="tabelaPet" class="table table-striped table-hover align-middle w-100">
                    <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Tutor</th>
                        <th>Espécie</th>
                        <th class="d-none d-md-table-cell">Raça</th>
                        <th class="d-none d-lg-table-cell">Sexo</th>
                        <th class="d-none d-lg-table-cell">Nascimento</th>
                        <th class="text-end">Ações</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var pet in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@pet.Nome</td>
                            <td>@(pet.Cliente?.Nome ?? "—")</td>
                            <td>@pet.Especie</td>
                            <td class="d-none d-md-table-cell">@(pet.Raca ?? "—")</td>
                            <td class="d-none d-lg-table-cell">@(pet.Sexo ?? "—")</td>
                            <td class="d-none d-lg-table-cell"
                                data-order="@(pet.DataNascimento.HasValue ? pet.DataNascimento.Value.ToString("yyyy-MM-dd") : "9999-99-99")">
                                @(pet.DataNascimento.HasValue ? pet.DataNascimento.Value.ToString("dd/MM/yyyy") : "—")
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@criptografarId(pet.Id)"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Editar" data-coreui-toggle="tooltip">
                                        <i class="cil-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@criptografarId(pet.Id)"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Excluir" data-coreui-toggle="tooltip">
                                        <i class="cil-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive/2.5.0/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaPet').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                responsive: true,
                order: [[0, 'asc']],
                columnDefs: [
                    { responsivePriority: 1, targets: 0 }, // Nome
                    { responsivePriority: 2, targets: 6 }, // Ações
                    { responsivePriority: 3, targets: 1 }, // Tutor
                    { responsivePriority: 4, targets: 2 }, // Espécie
                    { responsivePriority: 5, targets: 3 }, // Raça
                    { responsivePriority: 6, targets: 4 }, // Sexo
                    { responsivePriority: 7, targets: 5 }, // Nascimento
                    { orderable: false, targets: 6 }
                ],
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50]
            });

            document.querySelectorAll('[data-coreui-toggle="tooltip"]').forEach(el => {
                new coreui.Tooltip(el);
            });
        });
    </script>
}