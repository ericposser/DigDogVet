@* Delete.cshtml *@
@model DigDog.Models.Pet
@{
    ViewData["Title"] = "Excluir Pet";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5 text-danger"><i class="cil-trash me-2"></i>Excluir Pet</strong>
    </div>

    <div class="card-body">

        <!-- Alerta -->
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="cil-warning"></i>
                <strong>Atenção! Esta ação não pode ser desfeita.</strong>
            </div>
            <small>
                Ao excluir o pet <strong>@Model.Nome</strong>, todo o histórico vinculado a ele
                (consultas, vacinas e banho e tosa) será <strong>permanentemente removido</strong>.
            </small>
        </div>

        <!-- Dados do pet -->
        <dl class="row mb-0">
            <dt class="col-sm-3 fw-semibold">Nome do Pet</dt>
            <dd class="col-sm-9">@Model.Nome</dd>

            <dt class="col-sm-3 fw-semibold">Tutor</dt>
            <dd class="col-sm-9">@(Model.Cliente?.Nome ?? "—")</dd>

            <dt class="col-sm-3 fw-semibold">Espécie</dt>
            <dd class="col-sm-9">@Model.Especie</dd>

            <dt class="col-sm-3 fw-semibold">Raça</dt>
            <dd class="col-sm-9">@(Model.Raca ?? "—")</dd>

            <dt class="col-sm-3 fw-semibold">Sexo</dt>
            <dd class="col-sm-9">@(Model.Sexo ?? "—")</dd>

            <dt class="col-sm-3 fw-semibold">Data de Nascimento</dt>
            <dd class="col-sm-9">@(Model.DataNascimento.HasValue ? Model.DataNascimento.Value.ToString("dd/MM/yyyy") : "—")</dd>
        </dl>

        <!-- Botões -->
        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="cil-x me-1"></i> Cancelar
            </a>
            <form asp-action="Delete" asp-route-id="@ViewBag.IdCriptografado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="cil-trash me-1"></i> Confirmar Exclusão
                </button>
            </form>
        </div>

    </div>
</div>