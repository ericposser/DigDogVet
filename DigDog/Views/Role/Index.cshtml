@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Perfis de Acesso";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5">
            <i class="cil-shield-alt me-2"></i>Perfis de Acesso
        </strong>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="cil-plus me-1"></i>Novo Perfil
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-body-secondary py-5">
                <i class="cil-shield-alt" style="font-size:2rem; opacity:.4"></i>
                <p class="mt-2 mb-0 small fw-semibold">Nenhum perfil criado ainda.</p>
                <small>Crie perfis para controlar o acesso dos funcionários.</small>
            </div>
        }
        else
        {
            <table class="table table-hover table-striped mb-0 border-top">
                <thead class="table">
                <tr>
                    <th scope="col">Nome do Perfil</th>
                    <th scope="col" class="text-end pe-4">Ações</th>
                </tr>
                </thead>
                <tbody>
                @{ int i = 1; }
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="align-middle fw-semibold">
                            @role.Name
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@role.Id"
                                   class="btn btn-outline-primary btn-sm"
                                   title="Editar" data-coreui-toggle="tooltip">
                                    <i class="cil-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@role.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   title="Excluir" data-coreui-toggle="tooltip">
                                    <i class="cil-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>