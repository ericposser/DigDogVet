@model DigDog.Models.RoleFormViewModel

@* Nome do perfil *@
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="Nome" class="form-label fw-semibold"></label>
        <input asp-for="Nome" class="form-control"
               placeholder="Ex: Recepcionista, Veterinário..." />
        <span asp-validation-for="Nome" class="text-danger small"></span>
    </div>
</div>

@* Checkboxes agrupados por módulo *@
@if (Model.GruposPermissao.Any())
{
    <div class="row g-3">
        @foreach (var grupo in Model.GruposPermissao)
        {
            @* Gera um slug seguro para uso como atributo data e seletor CSS *@
            var slug = grupo.Key
                .Replace(" ", "-")
                .Replace("&", "e")
                .Replace("ã", "a")
                .Replace("ç", "c")
                .Replace("ão", "ao")
                .ToLowerInvariant();

            <div class="col-md-4">
                <div class="card border shadow-none bg-body-tertiary h-100">
                    <div class="card-header bg-transparent border-bottom py-2 d-flex justify-content-between align-items-center">
                        <strong class="small text-uppercase text-body-secondary">
                            <i class="cil-layers me-1"></i>@grupo.Key
                        </strong>
                        <button type="button"
                                class="btn btn-link btn-sm p-0 text-body-secondary text-decoration-none"
                                data-slug="@slug"
                                onclick="alternarGrupo(this)">
                            <small>Todos</small>
                        </button>
                    </div>
                    <div class="card-body py-2" id="grupo-@slug">
                        @foreach (var opcao in grupo.Value)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="PermissoesSelecionadas"
                                       value="@((int)opcao.Valor)"
                                       id="perm_@((int)opcao.Valor)"
                                       @(opcao.Selecionada ? "checked" : "") />
                                <label class="form-check-label small"
                                       for="perm_@((int)opcao.Valor)">
                                    @opcao.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* Botões globais *@
    <div class="mt-3 d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="marcarTodos(true)">
            <i class="cil-check-circle me-1"></i>Marcar todos
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="marcarTodos(false)">
            <i class="cil-x-circle me-1"></i>Desmarcar todos
        </button>
    </div>
}
else
{
    <div class="alert alert-warning border-0">
        <i class="cil-warning me-2"></i>
        Nenhuma permissão disponível para configurar.
    </div>
}