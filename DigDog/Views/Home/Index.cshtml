@model DigDog.Models.PainelViewModel
@{
    ViewData["Title"] = "Painel";
    var podeFaturamento = (bool)(ViewBag.PodeFaturamento ?? false);
    var hoje = DateTime.Today;

    var labelsJson         = podeFaturamento ? System.Text.Json.JsonSerializer.Serialize(Model.LabelsSeisMeses) : "[]";
    var dadosJson          = podeFaturamento ? System.Text.Json.JsonSerializer.Serialize(Model.ReceitaSeisMeses) : "[]";
    var receitaConsultasJs = podeFaturamento ? Model.ReceitaConsultas.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0";
    var receitaBanhosJs    = podeFaturamento ? Model.ReceitaBanhos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0";
    var receitaVendasJs    = podeFaturamento ? Model.ReceitaVendas.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0";
}

<style>
    .secao-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--cui-secondary-color, #6c757d);
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1rem;
    }
    .secao-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--cui-border-color, #dee2e6);
        opacity: .6;
    }
    .widget-card {
        border-radius: .75rem;
        border: none;
        overflow: hidden;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .widget-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,.12) !important;
    }
    .widget-card .card-body {
        padding: 1.25rem 1.4rem;
    }
    .widget-card .numero {
        font-size: 2.1rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: .2rem;
    }
    .widget-card .rotulo {
        font-size: .82rem;
        opacity: .85;
        font-weight: 500;
    }
    .widget-card .icone-fundo {
        font-size: 2.6rem;
        opacity: .18;
    }
    .widget-card .card-footer {
        font-size: .78rem;
        padding: .55rem 1.4rem;
        border: none !important;
    }
    .card-secao {
        border-radius: .75rem;
        border: 1px solid var(--cui-border-color, #dee2e6);
        box-shadow: 0 1px 6px rgba(0,0,0,.06);
    }
    .card-secao .card-header {
        border-radius: .75rem .75rem 0 0 !important;
        background: var(--cui-tertiary-bg, #f8f9fa);
        border-bottom: 1px solid var(--cui-border-color, #dee2e6);
        padding: .8rem 1.25rem;
    }
    .card-secao .titulo-card {
        font-size: .92rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .lista-agenda .list-group-item {
        border-left: none;
        border-right: none;
        border-radius: 0 !important;
        padding: .7rem 1.25rem;
        transition: background .1s;
    }
    .lista-agenda .list-group-item:first-child {
        border-top: none;
    }
    .lista-agenda .list-group-item:hover {
        background: var(--cui-tertiary-bg, #f8f9fa);
    }
    .lista-agenda .nome-pet {
        font-size: .88rem;
        font-weight: 600;
    }
    .lista-agenda .detalhe {
        font-size: .76rem;
        color: var(--cui-secondary-color, #6c757d);
    }
    .lista-agenda .badge-hora {
        font-size: .75rem;
        padding: .3rem .65rem;
        border-radius: .4rem;
    }
    .badge-mini {
        font-size: .72rem;
        padding: .25rem .55rem;
        border-radius: .35rem;
        font-weight: 600;
    }
    .estado-vazio {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--cui-secondary-color, #6c757d);
    }
    .estado-vazio i {
        font-size: 2.2rem;
        opacity: .35;
        display: block;
        margin-bottom: .5rem;
    }
    .estado-vazio .msg {
        font-size: .84rem;
        font-weight: 600;
        margin-bottom: .15rem;
    }
    .estado-vazio .sub {
        font-size: .78rem;
    }
    .faturamento-numero {
        font-size: 1.3rem;
        font-weight: 700;
    }
    .faturamento-label {
        font-size: .75rem;
        color: var(--cui-secondary-color, #6c757d);
        font-weight: 500;
    }
    .dot-legenda {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .separador-v {
        width: 1px;
        background: var(--cui-border-color, #dee2e6);
        opacity: .6;
        margin: .25rem 0;
    }
    .tabela-vendas th {
        font-size: .78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--cui-secondary-color, #6c757d);
        background: var(--cui-tertiary-bg, #f8f9fa);
        padding: .65rem 1rem;
    }
    .tabela-vendas td {
        font-size: .86rem;
        padding: .7rem 1rem;
        vertical-align: middle;
    }
</style>

@* ══════════════════════════════════════════════════════════════════════
   SEÇÃO 1 — RESUMO DO DIA
   ══════════════════════════════════════════════════════════════════════ *@
<div class="secao-label">
    <i class="cil-chart me-1"></i> Resumo Geral
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card widget-card text-white shadow-sm" style="background: linear-gradient(135deg,#3b82f6,#1d4ed8);">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="numero">@Model.TotalClientes</div>
                    <div class="rotulo">Tutores cadastrados</div>
                </div>
                <i class="cil-people icone-fundo"></i>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Cliente" asp-action="Index" class="text-white text-decoration-none">
                    Ver todos <i class="cil-arrow-right" style="font-size:.75rem"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card widget-card text-white shadow-sm" style="background: linear-gradient(135deg,#06b6d4,#0e7490);">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="numero">@Model.TotalPets</div>
                    <div class="rotulo">Pets registrados</div>
                </div>
                <i class="cil-paw icone-fundo"></i>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Pet" asp-action="Index" class="text-white text-decoration-none">
                    Ver todos <i class="cil-arrow-right" style="font-size:.75rem"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card widget-card text-white shadow-sm" style="background: linear-gradient(135deg,#10b981,#065f46);">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="numero">@Model.ConsultasHoje</div>
                    <div class="rotulo">Consultas hoje</div>
                </div>
                <i class="cil-medical-cross icone-fundo"></i>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Consulta" asp-action="Index" class="text-white text-decoration-none">
                    Ver agenda <i class="cil-arrow-right" style="font-size:.75rem"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card widget-card text-white shadow-sm" style="background: linear-gradient(135deg,#f59e0b,#b45309);">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="numero">@Model.BanhosHoje</div>
                    <div class="rotulo">Banho & Tosa hoje</div>
                </div>
                <i class="cil-drop icone-fundo"></i>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="BanhoTosa" asp-action="Index" class="text-white text-decoration-none">
                    Ver agenda <i class="cil-arrow-right" style="font-size:.75rem"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SEÇÃO 2 — AGENDA DO DIA
   ══════════════════════════════════════════════════════════════════════ *@
<div class="secao-label">
    <i class="cil-calendar me-1"></i> Agenda
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card card-secao h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="titulo-card">
                    <i class="cil-calendar text-primary"></i>
                    Próximas Consultas
                </span>
                <a asp-controller="Consulta" asp-action="Create" class="btn btn-primary btn-sm px-3">
                    <i class="cil-plus me-1"></i> Nova
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.ProximasConsultas.Any())
                {
                    <div class="estado-vazio">
                        <i class="cil-calendar"></i>
                        <div class="msg">Nenhuma consulta agendada</div>
                        <div class="sub">Novas consultas aparecerão aqui</div>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-agenda">
                        @foreach (var c in Model.ProximasConsultas)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="nome-pet">@c.Pet?.Nome</div>
                                    <div class="detalhe">@c.Motivo</div>
                                </div>
                                <span class="badge badge-mini bg-primary">@c.DataHora.ToString("dd/MM HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card card-secao h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="titulo-card">
                    <i class="cil-drop text-warning"></i>
                    Próximos Banho & Tosa
                </span>
                <a asp-controller="BanhoTosa" asp-action="Create" class="btn btn-warning btn-sm px-3 text-white">
                    <i class="cil-plus me-1"></i> Novo
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.ProximosBanhos.Any())
                {
                    <div class="estado-vazio">
                        <i class="cil-drop"></i>
                        <div class="msg">Nenhum agendamento</div>
                        <div class="sub">Banhos agendados aparecerão aqui</div>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-agenda">
                        @foreach (var b in Model.ProximosBanhos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="nome-pet">@b.Pet?.Nome</div>
                                    <div class="detalhe">@(b.TipoServico ?? "Banho & Tosa")</div>
                                </div>
                                <span class="badge badge-mini bg-warning text-dark">@b.DataHora.ToString("dd/MM HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SEÇÃO 3 — ALERTAS DE SAÚDE
   ══════════════════════════════════════════════════════════════════════ *@
<div class="secao-label">
    <i class="cil-bell me-1"></i> Alertas de Saúde
</div>

<div class="row g-3 mb-4">
    @* Card: Frascos vencendo *@
    <div class="col-lg-6">
        <div class="card card-secao h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="titulo-card">
                    <i class="cil-eyedropper text-warning"></i>
                    Frascos — Vencimento Próximo
                </span>
                <a asp-controller="Vacina" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    Ver catálogo
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.VacinasFrascosVencendo.Any())
                {
                    <div class="estado-vazio">
                        <i class="cil-check-circle" style="color: var(--cui-success,#2eb85c)"></i>
                        <div class="msg" style="color: var(--cui-success,#2eb85c)">Tudo em dia!</div>
                        <div class="sub">Nenhum frasco próximo do vencimento</div>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-agenda">
                        @foreach (var v in Model.VacinasFrascosVencendo)
                        {
                            var diasRestantes   = (v.DataValidade.Date - hoje).Days;
                            var corBadge        = diasRestantes <= 2 ? "bg-danger" : "bg-warning text-dark";
                            var textoVencimento = diasRestantes == 0 ? "vence hoje"
                                : diasRestantes < 0 ? $"vencido há {-diasRestantes}d"
                                : $"vence em {diasRestantes}d";
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="nome-pet">@v.Nome</div>
                                    <div class="detalhe">
                                        @(string.IsNullOrEmpty(v.Fabricante) ? "—" : v.Fabricante)
                                        @if (!string.IsNullOrEmpty(v.Lote)) { <span>· Lote @v.Lote</span> }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge badge-mini @corBadge">@textoVencimento</span>
                                    <div class="detalhe mt-1">@v.DataValidade.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @* Card: Doses de retorno *@
    <div class="col-lg-6">
        <div class="card card-secao h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="titulo-card">
                    <i class="cil-heart text-danger"></i>
                    Doses de Retorno — 7 Dias
                </span>
                <a asp-controller="Vacinacao" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    Ver carteira
                </a>
            </div>
            <div class="card-body p-0">
                @{
                    var temDosesOuAtrasos = Model.ProximasDoses.Any() || Model.DosesAtrasadas.Any();
                }
                @if (!temDosesOuAtrasos)
                {
                    <div class="estado-vazio">
                        <i class="cil-check-circle" style="color: var(--cui-success,#2eb85c)"></i>
                        <div class="msg" style="color: var(--cui-success,#2eb85c)">Todos em dia!</div>
                        <div class="sub">Nenhuma dose pendente nos próximos 7 dias</div>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-agenda">
                        @foreach (var v in Model.DosesAtrasadas)
                        {
                            var diasAtraso  = (hoje - v.DataProximaDose!.Value.Date).Days;
                            var textoAtraso = diasAtraso == 0 ? "hoje" : $"atrasada {diasAtraso}d";
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="nome-pet">@v.Pet?.Nome</div>
                                    <div class="detalhe">@v.Vacina?.Nome</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge badge-mini bg-danger">@textoAtraso</span>
                                    <div class="detalhe mt-1">@v.DataProximaDose?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>
                        }
                        @foreach (var v in Model.ProximasDoses)
                        {
                            var diasParaDose = (v.DataProximaDose!.Value.Date - hoje).Days;
                            var textoDose    = diasParaDose == 0 ? "hoje" : $"em {diasParaDose}d";
                            var corBadge     = diasParaDose <= 2 ? "bg-warning text-dark" : "bg-info";
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="nome-pet">@v.Pet?.Nome</div>
                                    <div class="detalhe">@v.Vacina?.Nome</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge badge-mini @corBadge">@textoDose</span>
                                    <div class="detalhe mt-1">@v.DataProximaDose?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SEÇÃO 4 — FATURAMENTO (somente com permissão)
   ══════════════════════════════════════════════════════════════════════ *@
@if (podeFaturamento)
{
    <div class="secao-label">
        <i class="cil-dollar me-1"></i> Faturamento
    </div>

    @* Bloco: totais + gráfico donut + gráfico linha *@
    <div class="row g-3 mb-4">

        @* Coluna esquerda: resumo financeiro *@
        <div class="col-lg-4">
            <div class="card card-secao h-100">
                <div class="card-header">
                    <span class="titulo-card">
                        <i class="cil-chart-pie text-info"></i>
                        Receita do Mês
                    </span>
                </div>
                <div class="card-body d-flex flex-column gap-3">

                    @* Total destaque *@
                    <div class="text-center py-2">
                        <div style="font-size:.78rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--cui-secondary-color,#6c757d);">Total do mês</div>
                        <div style="font-size:2.2rem; font-weight:700; line-height:1.1; margin-top:.25rem;">
                            R$ @Model.TotalReceitaMes.ToString("N2")
                        </div>
                    </div>

                    <hr class="my-0" style="opacity:.15">

                    @* Linhas por categoria *@
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-legenda" style="background:#5e5dd0"></span>
                                <span class="faturamento-label">Consultas</span>
                            </div>
                            <span class="faturamento-numero" style="color:#5e5dd0">R$ @Model.ReceitaConsultas.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-legenda" style="background:#229641"></span>
                                <span class="faturamento-label">Banho & Tosa</span>
                            </div>
                            <span class="faturamento-numero" style="color:#229641">R$ @Model.ReceitaBanhos.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="dot-legenda" style="background:#edad1f"></span>
                                <span class="faturamento-label">Vendas</span>
                            </div>
                            <span class="faturamento-numero" style="color:#b45309">R$ @Model.ReceitaVendas.ToString("N2")</span>
                        </div>
                    </div>

                    <hr class="my-0" style="opacity:.15">

                    @* Gráfico donut *@
                    <div style="position:relative; max-width:200px; margin:0 auto;">
                        <canvas id="graficoCategorias" height="180"></canvas>
                        <div id="semDadosCategorias" class="estado-vazio" style="display:none;">
                            <i class="cil-chart-pie"></i>
                            <div class="sub">Sem receita no mês</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @* Coluna direita: gráfico de linha *@
        <div class="col-lg-8">
            <div class="card card-secao h-100">
                <div class="card-header">
                    <span class="titulo-card">
                        <i class="cil-chart-line text-primary"></i>
                        Evolução — Últimos 6 Meses
                    </span>
                </div>
                <div class="card-body d-flex align-items-center" style="min-height:280px">
                    <canvas id="graficoReceita" style="width:100%; height:280px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* ── Últimas vendas ─────────────────────────────────────────────── *@
    <div class="secao-label">
        <i class="cil-cart me-1"></i> Últimas Vendas
    </div>

    <div class="card card-secao mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="titulo-card">
                <i class="cil-cart text-warning"></i>
                Vendas Recentes
            </span>
            <a asp-controller="Venda" asp-action="Create" class="btn btn-warning btn-sm px-3 text-white">
                <i class="cil-plus me-1"></i> Nova Venda
            </a>
        </div>
        <div class="card-body p-0">
            @if (!Model.UltimasVendas.Any())
            {
                <div class="estado-vazio">
                    <i class="cil-cart"></i>
                    <div class="msg">Nenhuma venda registrada</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 tabela-vendas">
                        <thead>
                        <tr>
                            <th class="ps-4">Produto</th>
                            <th>Qtd</th>
                            <th>Preço Unit.</th>
                            <th>Total</th>
                            <th>Data</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var v in Model.UltimasVendas)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@v.Produto?.Nome</td>
                                <td>@v.Quantidade</td>
                                <td class="text-body-secondary">R$ @v.PrecoUnitario.ToString("N2")</td>
                                <td>
                                    <span class="fw-semibold" style="color:var(--cui-success,#2eb85c)">R$ @v.Total.ToString("N2")</span>
                                </td>
                                <td class="text-body-secondary">@v.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    @if (podeFaturamento)
    {
        <script>
            (function () {
                const isDark = document.documentElement.getAttribute('data-coreui-theme') === 'dark'
                    || (document.documentElement.getAttribute('data-coreui-theme') === 'auto'
                        && window.matchMedia('(prefers-color-scheme: dark)').matches);

                const corTexto = isDark ? '#adb5bd' : '#6c757d';
                const corGrade = isDark ? '#2d3035' : '#e9ecef';

                new Chart(document.getElementById('graficoReceita').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(labelsJson),
                        datasets: [{
                            label: 'Receita (R$)',
                            data: @Html.Raw(dadosJson),
                            borderColor: '#5e5dd0',
                            backgroundColor: 'rgba(94,93,208,0.08)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.45,
                            pointBackgroundColor: '#5e5dd0',
                            pointRadius: 4,
                            pointHoverRadius: 6,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => 'R$ ' + ctx.parsed.y.toFixed(2).replace('.', ',')
                                }
                            }
                        },
                        scales: {
                            x: {
                                ticks: { color: corTexto, font: { size: 12 } },
                                grid: { color: corGrade }
                            },
                            y: {
                                min: 0,
                                ticks: {
                                    color: corTexto,
                                    font: { size: 11 },
                                    callback: v => 'R$ ' + v.toFixed(0)
                                },
                                grid: { color: corGrade }
                            }
                        }
                    }
                });

                const totalCategorias = @receitaConsultasJs + @receitaBanhosJs + @receitaVendasJs;

                if (totalCategorias > 0) {
                    new Chart(document.getElementById('graficoCategorias').getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: ['Consultas', 'Banho & Tosa', 'Vendas'],
                            datasets: [{
                                data: [@receitaConsultasJs, @receitaBanhosJs, @receitaVendasJs],
                                backgroundColor: ['#5e5dd0', '#229641', '#edad1f'],
                                hoverBackgroundColor: ['#4e4db0', '#1a7a34', '#d4961c'],
                                borderWidth: 0,
                            }]
                        },
                        options: {
                            responsive: true,
                            cutout: '72%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: ctx => ctx.label + ': R$ ' + ctx.parsed.toFixed(2)
                                    }
                                }
                            }
                        }
                    });
                } else {
                    document.getElementById('graficoCategorias').style.display = 'none';
                    document.getElementById('semDadosCategorias').style.display = 'block';
                }
            })();
        </script>
    }
}