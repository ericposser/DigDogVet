@model DigDog.Models.PainelViewModel
@{
    ViewData["Title"] = "Painel";
    var podeFaturamento = (bool)(ViewBag.PodeFaturamento ?? false);
    var hoje = DateTime.Today;

    var labelsJson         = podeFaturamento ? System.Text.Json.JsonSerializer.Serialize(Model.LabelsSeisMeses) : "[]";
    var dadosJson          = podeFaturamento ? System.Text.Json.JsonSerializer.Serialize(Model.ReceitaSeisMeses) : "[]";
    var receitaConsultasJs = podeFaturamento ? Model.ReceitaConsultas.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0";
    var receitaBanhosJs    = podeFaturamento ? Model.ReceitaBanhos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0";
    var receitaVendasJs    = podeFaturamento ? Model.ReceitaVendas.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0";
}

@* ── 1. Widgets principais ────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-3 fw-bold">@Model.TotalClientes</div>
                    <div class="small">Tutores</div>
                </div>
                <i class="cil-people" style="font-size:2rem;opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Cliente" asp-action="Index" class="text-white text-decoration-none small">Ver todos</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-3 fw-bold">@Model.TotalPets</div>
                    <div class="small">Pets</div>
                </div>
                <i class="cil-animal" style="font-size:2rem;opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Pet" asp-action="Index" class="text-white text-decoration-none small">Ver todos</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-3 fw-bold">@Model.ConsultasHoje</div>
                    <div class="small">Consultas Hoje</div>
                </div>
                <i class="cil-medical-cross" style="font-size:2rem;opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Consulta" asp-action="Index" class="text-white text-decoration-none small">Ver agenda</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-white bg-warning h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-3 fw-bold">@Model.BanhosHoje</div>
                    <div class="small">Banho & Tosa Hoje</div>
                </div>
                <i class="cil-drop" style="font-size:2rem;opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="BanhoTosa" asp-action="Index" class="text-white text-decoration-none small">Ver agenda</a>
            </div>
        </div>
    </div>
</div>

@* ── 2. Dois cards de vacinas lado a lado ─────────────────────────────── *@
<div class="row g-3 mb-4">

    @* Card: Frascos vencendo *@
    <div class="col-lg-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <strong class="fs-5">
                    <i class="cil-eyedropper me-2 text-warning"></i>Frascos de Vacina — Vencimento Próximo
                </strong>
                <a asp-controller="Vacina" asp-action="Index" class="btn btn-outline-secondary btn-sm">Ver catálogo</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.VacinasFrascosVencendo.Any())
                {
                    <div class="text-center text-body-secondary py-4">
                        <i class="cil-check-circle text-success" style="font-size:2rem"></i>
                        <p class="mt-2 mb-0 small fw-semibold">Nenhum frasco vencendo</p>
                        <small>Todos os frascos estão dentro do prazo.</small>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var v in Model.VacinasFrascosVencendo)
                        {
                            var diasRestantes    = (v.DataValidade.Date - hoje).Days;
                            var corBadge         = diasRestantes == 0 ? "bg-danger" : diasRestantes <= 2 ? "bg-danger" : "bg-warning text-dark";
                            var textoVencimento  = diasRestantes == 0 ? "vence hoje" : $"vence em {diasRestantes} dia(s)";
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold small">@v.Nome</div>
                                    <div class="text-body-secondary" style="font-size:.78rem">
                                        @(string.IsNullOrEmpty(v.Fabricante) ? "—" : v.Fabricante)
                                        @if (!string.IsNullOrEmpty(v.Lote)) { <span>· Lote @v.Lote</span> }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @corBadge">@textoVencimento</span>
                                    <div class="text-body-secondary" style="font-size:.75rem">@v.DataValidade.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @* Card: Doses de retorno próximas *@
    <div class="col-lg-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <strong class="fs-5">
                    <i class="cil-heart me-2 text-danger"></i>Doses de Retorno — Próximos 7 Dias
                </strong>
                <a asp-controller="Vacinacao" asp-action="Index" class="btn btn-outline-secondary btn-sm">Ver carteira</a>
            </div>
            <div class="card-body p-0">
                @{
                    var temDosesOuAtrasos = Model.ProximasDoses.Any() || Model.DosesAtrasadas.Any();
                }
                @if (!temDosesOuAtrasos)
                {
                    <div class="text-center text-body-secondary py-4">
                        <i class="cil-check-circle text-success" style="font-size:2rem"></i>
                        <p class="mt-2 mb-0 small fw-semibold">Nenhuma dose pendente</p>
                        <small>Todos os pets estão com as vacinas em dia.</small>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var v in Model.DosesAtrasadas)
                        {
                            var diasAtraso  = (hoje - v.DataProximaDose!.Value.Date).Days;
                            var textoAtraso = diasAtraso == 0 ? "vence hoje" : $"atrasada {diasAtraso} dia(s)";
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold small">@v.Pet?.Nome</div>
                                    <div class="text-body-secondary" style="font-size:.78rem">@v.Vacina?.Nome</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-danger">@textoAtraso</span>
                                    <div class="text-body-secondary" style="font-size:.75rem">@v.DataProximaDose?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>
                        }
                        @foreach (var v in Model.ProximasDoses)
                        {
                            var diasParaDose = (v.DataProximaDose!.Value.Date - hoje).Days;
                            var textoDose    = diasParaDose == 0 ? "hoje" : $"em {diasParaDose} dia(s)";
                            var corBadge     = diasParaDose <= 2 ? "bg-warning text-dark" : "bg-info";
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold small">@v.Pet?.Nome</div>
                                    <div class="text-body-secondary" style="font-size:.78rem">@v.Vacina?.Nome</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @corBadge">@textoDose</span>
                                    <div class="text-body-secondary" style="font-size:.75rem">@v.DataProximaDose?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@* ── 3. Próximas consultas + Banhos agendados ─────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <strong class="fs-5"><i class="cil-calendar me-2 text-primary"></i>Próximas Consultas</strong>
                <a asp-controller="Consulta" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="cil-plus me-1"></i>Nova
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.ProximasConsultas.Any())
                {
                    <div class="text-center text-body-secondary py-4">
                        <i class="cil-calendar" style="font-size:2rem"></i>
                        <p class="mt-2 mb-0 small">Nenhuma consulta agendada</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in Model.ProximasConsultas)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold small">@c.Pet?.Nome</div>
                                    <div class="text-body-secondary" style="font-size:.78rem">@c.Motivo</div>
                                </div>
                                <span class="badge bg-primary">@c.DataHora.ToString("dd/MM HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <strong class="fs-5"><i class="cil-drop me-2 text-warning"></i>Próximos Banho & Tosa</strong>
                <a asp-controller="BanhoTosa" asp-action="Create" class="btn btn-warning btn-sm text-white">
                    <i class="cil-plus me-1"></i>Novo
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.ProximosBanhos.Any())
                {
                    <div class="text-center text-body-secondary py-4">
                        <i class="cil-drop" style="font-size:2rem"></i>
                        <p class="mt-2 mb-0 small">Nenhum agendamento</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var b in Model.ProximosBanhos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold small">@b.Pet?.Nome</div>
                                    <div class="text-body-secondary" style="font-size:.78rem">@(b.TipoServico ?? "Banho & Tosa")</div>
                                </div>
                                <span class="badge bg-warning text-dark">@b.DataHora.ToString("dd/MM HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@* ── 4 e 5. Faturamento — apenas para quem tem permissão ─────────────── *@
@if (podeFaturamento)
{
    @* ── 4. Gráficos ─────────────────────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-body-secondary small fw-semibold text-uppercase">Receita por Categoria</span>
                        <i class="cil-chart-pie text-info fs-5"></i>
                    </div>
                    <div class="d-flex justify-content-between small mb-2 mt-2">
                        <span><span class="badge bg-primary me-1">&nbsp;</span>Consultas</span>
                        <span class="fw-semibold">R$ @Model.ReceitaConsultas.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-2">
                        <span><span class="badge bg-success me-1">&nbsp;</span>Banho & Tosa</span>
                        <span class="fw-semibold">R$ @Model.ReceitaBanhos.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-2">
                        <span><span class="badge bg-warning me-1">&nbsp;</span>Vendas</span>
                        <span class="fw-semibold">R$ @Model.ReceitaVendas.ToString("N2")</span>
                    </div>
                    <div class="border-top mt-2 pt-2 d-flex justify-content-between small">
                        <span class="text-body-secondary">Total do mês</span>
                        <span class="fw-bold">R$ @Model.TotalReceitaMes.ToString("N2")</span>
                    </div>
                    <div class="mt-3">
                        <canvas id="graficoCategorias" height="160"></canvas>
                        <div id="semDadosCategorias" class="text-center text-body-secondary py-3"
                             style="display:none; flex-direction:column; align-items:center;">
                            <i class="cil-chart-pie" style="font-size:2rem; opacity:.4"></i>
                            <small class="mt-1">Sem receita no mês</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body-tertiary">
                    <strong class="fs-5"><i class="cil-chart-line me-2"></i>Receita — Últimos 6 Meses</strong>
                </div>
                <div class="card-body p-3 d-flex align-items-center">
                    <canvas id="graficoReceita" style="width:100%; height:320px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* ── 5. Últimas vendas ────────────────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                    <strong class="fs-5"><i class="cil-cart me-2 text-warning"></i>Últimas Vendas</strong>
                    <a asp-controller="Venda" asp-action="Create" class="btn btn-warning btn-sm text-white">
                        <i class="cil-plus me-1"></i>Nova
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.UltimasVendas.Any())
                    {
                        <div class="text-center text-body-secondary py-4 small">Nenhuma venda registrada</div>
                    }
                    else
                    {
                        <table class="table table-hover table-striped mb-0 border-top">
                            <thead class="table">
                            <tr>
                                <th class="ps-4">Produto</th>
                                <th>Qtd</th>
                                <th>Preço Unit.</th>
                                <th>Total</th>
                                <th>Data</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var v in Model.UltimasVendas)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@v.Produto?.Nome</td>
                                    <td>@v.Quantidade</td>
                                    <td>R$ @v.PrecoUnitario.ToString("N2")</td>
                                    <td class="fw-semibold text-success">R$ @v.Total.ToString("N2")</td>
                                    <td class="text-body-secondary small">@v.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (podeFaturamento)
    {
        <script>
            (function () {
                const isDark = document.documentElement.getAttribute('data-coreui-theme') === 'dark'
                    || (document.documentElement.getAttribute('data-coreui-theme') === 'auto'
                        && window.matchMedia('(prefers-color-scheme: dark)').matches);

                const corTexto = isDark ? '#adb5bd' : '#6c757d';
                const corGrade = isDark ? '#2d3035' : '#e9ecef';

                new Chart(document.getElementById('graficoReceita').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(labelsJson),
                        datasets: [{
                            label: 'Receita (R$)',
                            data: @Html.Raw(dadosJson),
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13,110,253,0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#0d6efd',
                            pointRadius: 4,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: ctx => 'R$ ' + ctx.parsed.y.toFixed(2).replace('.', ',') } }
                        },
                        scales: {
                            x: { ticks: { color: corTexto }, grid: { color: corGrade } },
                            y: {
                                min: 0,
                                max: 10000,
                                ticks: { color: corTexto, stepSize: 1000, callback: v => 'R$ ' + v.toFixed(0) },
                                grid: { color: corGrade }
                            }
                        }
                    }
                });

                const totalCategorias = @receitaConsultasJs + @receitaBanhosJs + @receitaVendasJs;

                if (totalCategorias > 0) {
                    new Chart(document.getElementById('graficoCategorias').getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: ['Consultas', 'Banho & Tosa', 'Vendas'],
                            datasets: [{
                                data: [@receitaConsultasJs, @receitaBanhosJs, @receitaVendasJs],
                                backgroundColor: ['#5e5dd0', '#229641', '#edad1f'],
                                hoverBackgroundColor: ['#5e5dd0', '#229641', '#edad1f'],
                                borderWidth: 0,
                            }]
                        },
                        options: {
                            responsive: true,
                            cutout: '70%',
                            plugins: {
                                legend: { display: false },
                                tooltip: { callbacks: { label: ctx => ctx.label + ': R$ ' + ctx.parsed.toFixed(2) } }
                            }
                        }
                    });
                } else {
                    document.getElementById('graficoCategorias').style.display = 'none';
                    document.getElementById('semDadosCategorias').style.display = 'flex';
                }
            })();
        </script>
    }
}
