@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assinatura Inativa — DigDog Vet</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@coreui/coreui@5.6.1/dist/css/coreui.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@coreui/icons@3.0.1/css/all.min.css" />
    <style>
        @@media (prefers-color-scheme: dark) {
            :root {
                --cui-body-bg: #1a1d27;
                --cui-body-color: #f1f5f9;
                --cui-border-color: #2d3148;
                --cui-tertiary-bg: #21253a;
                --cui-secondary-color: #94a3b8;
                color-scheme: dark;
            }
            body { background-color: #0f1117; }
        }

        @@media (prefers-color-scheme: light) {
            :root {
                --cui-body-bg: #ffffff;
                --cui-body-color: #1a202c;
                --cui-border-color: #e2e8f0;
                --cui-tertiary-bg: #f8fafc;
                --cui-secondary-color: #64748b;
                color-scheme: light;
            }
            body { background-color: #f0f4f8; }
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            color: var(--cui-body-color);
        }

        .inativa-card {
            width: 100%;
            max-width: 480px;
            background: var(--cui-body-bg);
            border: 1px solid var(--cui-border-color);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.10);
        }

        .inativa-topo {
            padding: 2.25rem 2.25rem 2rem;
            border-bottom: 1px solid var(--cui-border-color);
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .inativa-icone-circulo {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: rgba(239,68,68,0.10);
            border: 1.5px solid rgba(239,68,68,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .inativa-icone-circulo i {
            font-size: 1.6rem;
            color: #ef4444;
        }

        .inativa-titulo {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.2;
            color: var(--cui-body-color);
        }

        .inativa-subtitulo {
            font-size: 0.82rem;
            color: var(--cui-secondary-color);
            margin-top: 0.3rem;
            line-height: 1.5;
        }

        .inativa-corpo {
            padding: 1.75rem 2.25rem 2.25rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .inativa-info {
            background: var(--cui-tertiary-bg);
            border: 1px solid var(--cui-border-color);
            border-radius: 14px;
            padding: 1rem 1.25rem;
            display: flex;
            gap: 0.75rem;
            align-items: flex-start;
        }

        .inativa-info i {
            font-size: 1rem;
            color: #ef4444;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .inativa-info-texto {
            font-size: 0.85rem;
            color: var(--cui-secondary-color);
            line-height: 1.6;
        }

        .inativa-info-texto strong {
            display: block;
            color: var(--cui-body-color);
            font-size: 0.88rem;
            margin-bottom: 2px;
        }

        .btn-assinar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 13px 20px;
            background: #10b981;
            color: #fff !important;
            border: none;
            border-radius: 12px;
            font-size: 0.92rem;
            font-weight: 700;
            text-decoration: none;
            transition: background 0.2s, transform 0.1s;
            cursor: pointer;
        }

        .btn-assinar:hover {
            background: #059669;
            transform: translateY(-1px);
        }

        .btn-assinar:active {
            transform: translateY(0);
        }

        .inativa-nota {
            font-size: 0.74rem;
            text-align: center;
            color: var(--cui-secondary-color);
            line-height: 1.5;
        }

        @@media (max-width: 480px) {
            .inativa-topo { padding: 1.5rem; }
            .inativa-corpo { padding: 1.25rem 1.5rem 1.75rem; }
        }
    </style>
</head>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    var idEmpresa = @(ViewBag.IdEmpresa ?? 0);

    if (idEmpresa > 0) {
        const conexao = new signalR.HubConnectionBuilder()
            .withUrl('/assinaturaHub')
            .withAutomaticReconnect()
            .build();

        conexao.on('AssinaturaAtivada', () => {
            window.location.href = '/Home/Index';
        });

        conexao.start().then(() => {
            conexao.invoke('EntrarGrupo', String(idEmpresa));
        });
    }
</script>

<body>
<div class="inativa-card">

    <div class="inativa-topo">
        <div class="inativa-icone-circulo">
            <i class="cil-ban"></i>
        </div>
        <div>
            <div class="inativa-titulo">Assinatura Inativa</div>
            <div class="inativa-subtitulo">O acesso ao sistema está suspenso</div>
        </div>
    </div>

    <div class="inativa-corpo">

        <div class="inativa-info">
            <i class="cil-warning"></i>
            <div class="inativa-info-texto">
                <strong>O que aconteceu?</strong>
                Sua assinatura expirou ou foi desativada. Renove para continuar utilizando todos os recursos do DigDogVet.
            </div>
        </div>

        <a href="https://pay.cakto.com.br/37xeduf_898582" target="_blank" class="btn-assinar">
            <i class="cil-credit-card"></i>
            Assinar agora
        </a>

    </div>
</div>
</body>
</html>