@model IEnumerable<DigDog.Models.Produto>
@{
    ViewData["Title"] = "Produtos";
    var criptografarId = ViewBag.CriptografarId as Func<int, string>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.css" />

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5"><i class="cil-basket me-2"></i>Produtos</strong>
        <div class="d-flex gap-2">
            <a asp-controller="Venda" asp-action="Index" class="btn btn-outline-success btn-sm">
                <i class="cil-cart me-1"></i> Vendas
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="cil-plus me-1"></i> Novo Produto
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-body-secondary py-5">
                <i class="cil-basket" style="font-size: 2.5rem;"></i>
                <p class="mt-3 mb-1 fw-semibold">Nenhum produto cadastrado</p>
                <small>Clique em "Novo Produto" para começar.</small>
            </div>
        }
        else
        {
            <div class="px-3 pt-3">
                <table id="tabelaProduto" class="table table-striped table-hover align-middle w-100">
                    <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th class="d-none d-md-table-cell">Descrição</th>
                        <th class="text-end">Ações</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var produto in Model)
                    {
                        var estoqueClass = produto.Estoque == 0 ? "text-danger fw-semibold"
                            : produto.Estoque <= 5 ? "text-warning fw-semibold" : "";
                        <tr>
                            <td class="fw-semibold">@produto.Nome</td>
                            <td>@produto.Preco.ToString("C2")</td>
                            <td class="@estoqueClass">
                                @produto.Estoque
                                @if (produto.Estoque == 0)
                                { <span class="badge bg-danger ms-1">Sem estoque</span> }
                                else if (produto.Estoque <= 5)
                                { <span class="badge bg-warning ms-1">Estoque baixo</span> }
                            </td>
                            <td class="d-none d-md-table-cell">@(produto.Descricao ?? "—")</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@criptografarId(produto.Id)"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Editar" data-coreui-toggle="tooltip">
                                        <i class="cil-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@criptografarId(produto.Id)"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Excluir" data-coreui-toggle="tooltip">
                                        <i class="cil-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/1.13.6/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive/2.5.0/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-responsive-bs5/2.5.0/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaProduto').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                responsive: true,
                order: [[0, 'asc']],
                columnDefs: [
                    { responsivePriority: 1, targets: 0 }, // Nome
                    { responsivePriority: 2, targets: 4 }, // Ações
                    { responsivePriority: 3, targets: 2 }, // Estoque
                    { responsivePriority: 4, targets: 1 }, // Preço
                    { responsivePriority: 5, targets: 3 }, // Descrição
                    { orderable: false, targets: 4 }
                ],
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50]
            });

            document.querySelectorAll('[data-coreui-toggle="tooltip"]').forEach(el => {
                new coreui.Tooltip(el);
            });
        });
    </script>
}