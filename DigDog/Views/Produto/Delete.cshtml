@model DigDog.Models.Produto
@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5 text-danger"><i class="cil-trash me-2"></i>Excluir Produto</strong>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="cil-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <div class="card-body">

        <div class="alert alert-danger border-0 shadow-sm mb-4">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="cil-warning"></i>
                <strong>Atenção! Esta ação não pode ser desfeita.</strong>
            </div>
            <small>
                O produto <strong>@Model.Nome</strong> será
                <strong>permanentemente removido</strong> do catálogo.
            </small>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3 fw-semibold">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>

            <dt class="col-sm-3 fw-semibold">Preço</dt>
            <dd class="col-sm-9">@Model.Preco.ToString("C2")</dd>

            <dt class="col-sm-3 fw-semibold">Estoque</dt>
            <dd class="col-sm-9">@Model.Estoque unidade(s)</dd>

            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                <dt class="col-sm-3 fw-semibold">Descrição</dt>
                <dd class="col-sm-9">@Model.Descricao</dd>
            }
        </dl>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="cil-x me-1"></i> Cancelar
            </a>
            <form asp-action="Delete" asp-route-id="@ViewBag.IdCriptografado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="cil-trash me-1"></i> Confirmar Exclusão
                </button>
            </form>
        </div>

    </div>
</div>