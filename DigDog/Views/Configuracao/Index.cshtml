@model DigDog.Models.Configuracao

@{
    ViewData["Title"] = "Configurações do Sistema";
}

<div class="row g-4">
    <div class="col-lg-8">

        <div class="card shadow-sm border-top-primary border-top-3 mb-4">
            <div class="card-header bg-body-tertiary">
                <strong class="fs-5">Dados da Clínica / PetShop</strong>
            </div>
            <div class="card-body">
                <form asp-action="Salvar" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-auto">
                            @if (Model?.FotoDados != null)
                            {
                                var base64 = Convert.ToBase64String(Model.FotoDados);
                                var imgSrc = $"data:{Model.FotoMimeType};base64,{base64}";
                                <img src="@imgSrc" class="rounded-circle border"
                                     style="width: 75px; height: 75px; object-fit: cover;" id="previewAvatar" />
                            }
                            else
                            {
                                <div id="placeholderAvatar"
                                     class="avatar avatar-xl bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fs-3"
                                     style="width: 75px; height: 75px;">
                                    <i class="cil-user"></i>
                                </div>
                                <img class="rounded-circle border d-none"
                                     style="width: 75px; height: 75px; object-fit: cover;" id="previewAvatar" />
                            }
                        </div>
                        <div class="col">
                            <label class="form-label fw-semibold">Foto de Perfil / Logotipo</label>
                            <input type="file" name="foto" class="form-control"
                                   accept="image/jpeg,image/png,image/webp"
                                   onchange="exibirPreview(this)" />
                            <span class="text-muted small">
                                A imagem será ajustada em formato circular.
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        
                        <div class="col-12">
                            <label asp-for="NomeEstabelecimento" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                            <input asp-for="NomeEstabelecimento" class="form-control"
                                   placeholder="Ex: DigDogVet Clínica Veterinária" />
                            <span asp-validation-for="NomeEstabelecimento" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-4">
                            <label asp-for="Telefone" class="form-label fw-semibold"></label>
                            <input asp-for="Telefone" id="TelefoneConfig" class="form-control"
                                   placeholder="(55) 99999-9999" maxlength="15" />
                        </div>
                        
                        <div class="col-md-8">
                            <label asp-for="Endereco" class="form-label fw-semibold"></label>
                            <input asp-for="Endereco" class="form-control"
                                   placeholder="Rua, número, bairro, cidade — UF" />
                        </div>

                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary text-white">
                            <i class="cil-save me-1"></i> Salvar Estabelecimento
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-top-warning border-top-3">
            <div class="card-header bg-body-tertiary">
                <strong class="fs-5">Segurança da Conta</strong>
            </div>
            <div class="card-body">

                <form asp-action="AtualizarEmail" method="post" class="mb-4">
                    <h6 class="fw-bold mb-3 text-body-secondary">
                        <i class="cil-envelope-closed me-2"></i>Alterar E-mail de Acesso
                    </h6>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">E-mail Atual / Novo E-mail</label>
                            <input type="email" name="NovoEmail" class="form-control"
                                   value="@ViewBag.EmailUsuario" required />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-warning text-dark w-100 fw-semibold">
                                Atualizar E-mail
                            </button>
                        </div>
                    </div>
                </form>

                <hr class="my-4" />

                <form asp-action="AtualizarSenha" method="post">
                    <h6 class="fw-bold mb-3 text-body-secondary">
                        <i class="cil-lock-locked me-2"></i>Alterar Senha
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Senha Atual</label>
                            <div class="input-group">
                                <input type="password" name="SenhaAtual" class="form-control" required />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="alternarSenha(this)">
                                    <i class="cil-lock-locked"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Nova Senha</label>
                            <div class="input-group">
                                <input type="password" name="NovaSenha" class="form-control" required />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="alternarSenha(this)">
                                    <i class="cil-lock-locked"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Confirmar Nova Senha</label>
                            <div class="input-group">
                                <input type="password" name="ConfirmarSenha" class="form-control" required />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="alternarSenha(this)">
                                    <i class="cil-lock-locked"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 mt-3 text-end">
                            <button type="submit" class="btn btn-danger text-white fw-semibold">
                                Alterar Senha
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm mb-4">
            <div class="card-body text-center">
                <i class="cil-short-text fs-1 text-primary mb-2"></i>
                <h6 class="card-title fw-bold mb-1">Enviar Ticket</h6>
                <p class="card-text text-muted small mb-3">
                    Encontrou um erro ou tem uma sugestão?<br />Registre um ticket para a equipe.
                </p>
                <a asp-controller="Ticket" asp-action="Enviar" class="btn btn-primary w-100 fw-semibold text-white">
                    <i class="cil-short-text me-1"></i> Abrir Ticket
                </a>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body text-center">
                <i class="cil-speech fs-1 text-success mb-2"></i>
                <h6 class="card-title fw-bold mb-1">Suporte Técnico</h6>
                <p class="card-text text-muted small mb-3">
                    Alguma dúvida ou problema?<br />Fale com a gente pelo WhatsApp.
                </p>
                <a href="https://wa.me/55999808201" target="_blank"
                   class="btn btn-success w-100 fw-semibold text-white">
                    <i class="cil-chat-bubble me-1"></i> Chamar no WhatsApp
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body text-center">
                @if (Model?.FotoDados != null)
                {
                    var base64 = Convert.ToBase64String(Model.FotoDados);
                    var imgSrc = $"data:{Model.FotoMimeType};base64,{base64}";
                    <img src="@imgSrc" class="rounded-circle border mb-3"
                         style="width: 80px; height: 80px; object-fit: cover;" />
                }
                else
                {
                    <i class="cil-info fs-1 text-primary mb-2"></i>
                }
                <h5 class="card-title">@(Model?.NomeEstabelecimento ?? "DigDogVet")</h5>
                <p class="card-text text-muted small mb-0">
                    Versão 1.0.0 <br />
                    Licenciado para uso exclusivo. <br />
                    &copy; 2026 DigDogVet. Todos os direitos reservados.
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function exibirPreview(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const imgPreview   = document.getElementById('previewAvatar');
                    const placeholder  = document.getElementById('placeholderAvatar');
                    if (placeholder) placeholder.classList.add('d-none');
                    imgPreview.src = e.target.result;
                    imgPreview.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function alternarSenha(botao) {
            const input = botao.closest('.input-group').querySelector('input');
            const icone = botao.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icone.classList.replace('cil-lock-locked', 'cil-lock-unlocked');
            } else {
                input.type = 'password';
                icone.classList.replace('cil-lock-unlocked', 'cil-lock-locked');
            }
        }

        // Máscara de telefone
        document.addEventListener('DOMContentLoaded', () => {
            const tel = document.getElementById('TelefoneConfig');
            if (tel) {
                tel.addEventListener('input', () => {
                    let v = tel.value.replace(/\D/g, '').slice(0, 11);
                    if (v.length > 6)
                        v = v.replace(/^(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
                    else if (v.length > 2)
                        v = v.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
                    else if (v.length > 0)
                        v = v.replace(/^(\d{0,2})/, '($1');
                    tel.value = v;
                });
            }
        });
    </script>
}
