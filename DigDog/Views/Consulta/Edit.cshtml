@model DigDog.Models.Consulta
@{
    ViewData["Title"] = "Editar Consulta";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
        <strong class="fs-5"><i class="cil-pencil me-2"></i>Editar Consulta</strong>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="cil-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.IdCriptografado" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small" role="alert"></div>

            <div class="row g-3">

                <!-- Pet -->
                <div class="col-md-6">
                    <label asp-for="IdPet" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                    <select asp-for="IdPet" class="form-select" asp-items="ViewBag.IdPet">
                        <option value="">— Selecione o pet —</option>
                    </select>
                    <span asp-validation-for="IdPet" class="text-danger small"></span>
                </div>

                <!-- Data e Hora -->
                <div class="col-md-6">
                    <label asp-for="DataHora" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                    <input asp-for="DataHora" class="form-control" type="datetime-local" />
                    <span asp-validation-for="DataHora" class="text-danger small"></span>
                </div>

                <!-- Valor -->
                <div class="col-md-4">
                    <label asp-for="Valor" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="Valor" class="form-control" type="text"
                               inputmode="numeric" placeholder="0,00"
                               data-val="false" />
                    </div>
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>

                <!-- Motivo -->
                <div class="col-12">
                    <label asp-for="Motivo" class="form-label fw-semibold"></label><span class="text-primary ms-1">*</span>
                    <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Motivo" class="text-danger small"></span>
                </div>

                <!-- Diagnóstico -->
                <div class="col-md-6">
                    <label asp-for="Diagnostico" class="form-label fw-semibold"></label>
                    <textarea asp-for="Diagnostico" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Diagnostico" class="text-danger small"></span>
                </div>

                <!-- Prescrição -->
                <div class="col-md-6">
                    <label asp-for="Prescricao" class="form-label fw-semibold"></label>
                    <textarea asp-for="Prescricao" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Prescricao" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="cil-x me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="cil-save me-1"></i> Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const campValor = document.getElementById('Valor');

        // Formata ao digitar
        campValor.addEventListener('input', function () {
            let apenasNumeros = this.value.replace(/\D/g, '');
            if (!apenasNumeros) { this.value = ''; return; }
            let numero = (parseInt(apenasNumeros) / 100).toFixed(2);
            this.value = numero
                .replace('.', ',')
                .replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        });

        // Converte antes de submeter e desativa validação do campo
        document.querySelector('form').addEventListener('submit', function () {
            // Remove o campo da validação do jQuery Validate
            $(campValor).rules('remove');

            let v = campValor.value
                .replace(/\./g, '')
                .replace(',', '.');

            campValor.value = isNaN(parseFloat(v)) ? '' : parseFloat(v).toFixed(2);
        });
    </script>
}